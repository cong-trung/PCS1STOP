<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- everything goes to the app on this PC: the port is server.port of config.json -->
        <rule name="PCS1Stop" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8007/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
